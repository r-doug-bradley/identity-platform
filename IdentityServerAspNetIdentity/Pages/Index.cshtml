@page
@model IdentityServerAspNetIdentity.Pages.Home.Index
@using Duende.IdentityServer.Extensions
@{
    ViewData["Title"] = "My account";
    var displayName = User?.GetDisplayName();
    var isAuthed = !string.IsNullOrWhiteSpace(displayName);
}

@if (isAuthed)
{
    <div class="account-hero">
        <h1>Welcome, @displayName</h1>
        <p class="lead">Manage your Keystone identity, sessions, and authorized apps.</p>
    </div>

    <div class="account-grid">
        <a class="account-tile" asp-page="/Grants/Index">
            <span class="account-tile__icon">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 8a2 2 0 0 0-2-2H7L5 4H3v16h16a2 2 0 0 0 2-2V8z"/>
                </svg>
            </span>
            <div class="account-tile__title">Stored grants</div>
            <div class="account-tile__desc">Apps you've authorized to access your account. Revoke access at any time.</div>
        </a>

        <a class="account-tile" asp-page="/Account/TwoFactor/Index">
            <span class="account-tile__icon">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="5" y="11" width="14" height="10" rx="2"/>
                    <path d="M8 11V8a4 4 0 0 1 8 0v3"/>
                </svg>
            </span>
            <div class="account-tile__title">Two-factor authentication</div>
            <div class="account-tile__desc">Manage your authenticator app and recovery codes for stronger sign-in security.</div>
        </a>

        <a class="account-tile" asp-page="/Account/Logout/Index">
            <span class="account-tile__icon">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
            </span>
            <div class="account-tile__title">Sign out</div>
            <div class="account-tile__desc">End your current session on this device.</div>
        </a>
    </div>
}
else
{
    <div class="signin-card">
        <h1>Keystone</h1>
        <p>Sign in to manage your account, authorized apps, and security settings.</p>
        <a class="btn btn-primary" asp-page="/Account/Login/Index">Sign in</a>
    </div>
}
