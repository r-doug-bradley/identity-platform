@*
    Branded chrome for the logged-in / mixed-audience keystone pages: Index landing,
    Grants, Diagnostics, ServerSideSessions, Ciba, Device, Consent, ExternalLogin.
    Login / MFA / password-reset pages use _AuthLayout.cshtml instead.
*@
@using Duende.IdentityServer.Extensions
@{
    var signedOut = true.Equals(ViewData["signed-out"]);
    var displayName = !signedOut ? Context.User?.GetDisplayName() : null;
    var isAuthed = !string.IsNullOrWhiteSpace(displayName);

    static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        return string.Concat(parts.Take(2).Select(p => char.ToUpperInvariant(p[0])));
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no" />

    <title>@(ViewData["Title"] ?? "Account") - Keystone</title>

    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/keystone-theme.css" asp-append-version="true" />
</head>
<body>
    <header class="keystone-header">
        <a href="~/" class="keystone-brand" aria-label="Keystone — Identity Platform">
            <span class="keystone-brand__icon">
                <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M22 28 V20 a10 10 0 0 1 20 0 V28" fill="none" stroke="white" stroke-width="4" stroke-linecap="round"></path>
                    <rect x="14" y="28" width="36" height="28" rx="6" fill="white"></rect>
                    <circle cx="32" cy="39" r="4.5" fill="#B8862B"></circle>
                    <rect x="30" y="41" width="4" height="9" rx="1.5" fill="#B8862B"></rect>
                </svg>
            </span>
            <span class="keystone-brand__wordmark">
                <span class="keystone-brand__title">Keystone</span>
                <span class="keystone-brand__tagline">Identity Platform</span>
            </span>
        </a>

        @if (isAuthed)
        {
            <div class="dropdown">
                <button class="avatar-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account menu">
                    <span class="avatar-circle">@Initials(displayName)</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li class="dropdown-item-text">
                        <div class="text-muted small">Signed in as</div>
                        <div class="fw-semibold">@displayName</div>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><a class="dropdown-item" asp-page="/Account/TwoFactor/Index">Two-factor</a></li>
                    <li><a class="dropdown-item" asp-page="/Grants/Index">Stored grants</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><a class="dropdown-item" asp-page="/Account/Logout/Index">Sign out</a></li>
                </ul>
            </div>
        }
    </header>

    <main class="keystone-main">
        <div class="keystone-content">
            @RenderBody()
        </div>
    </main>

    <footer class="keystone-footer">
        &copy; @DateTime.UtcNow.Year Keystone Identity Platform
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("scripts", required: false)
</body>
</html>
