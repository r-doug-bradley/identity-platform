@page
@model IdentityServerAspNetIdentity.Pages.Account.ResetPassword.DoneModel
@{
    ViewData["Title"] = "Password updated";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <h1>Password updated</h1>
    <p class="auth-subtitle">You can now sign in with your new password.</p>

    <div class="d-grid">
        <a class="btn btn-primary" asp-page="/Account/Login/Index" asp-route-returnUrl="@Model.ReturnUrl">Back to sign in</a>
    </div>
</div>
