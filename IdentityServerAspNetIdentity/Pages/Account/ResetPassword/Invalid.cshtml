@page
@model IdentityServerAspNetIdentity.Pages.Account.ResetPassword.InvalidModel
@{
    ViewData["Title"] = "Invalid reset link";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <h1>Invalid reset link</h1>
    <p class="auth-subtitle">This reset link is invalid or has expired. Request a new one from the sign-in page.</p>

    <div class="d-grid">
        <a class="btn btn-primary" asp-page="/Account/ForgotPassword/Index">Request a new link</a>
    </div>
</div>
