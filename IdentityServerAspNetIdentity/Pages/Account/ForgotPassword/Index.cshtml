@page
@model IdentityServerAspNetIdentity.Pages.Account.ForgotPassword.IndexModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <h1>Forgot password</h1>
    <p class="auth-subtitle">Enter your username and we'll send you a reset link.</p>

    <partial name="_ValidationSummary" />

    <form method="post">
        <input type="hidden" asp-for="Input.ReturnUrl" />

        <div class="mb-3">
            <label class="form-label" asp-for="Input.UserName"></label>
            <input class="form-control" asp-for="Input.UserName" autofocus />
        </div>

        <div class="d-grid gap-2">
            <button class="btn btn-primary" type="submit">Send reset link</button>
            <a class="btn btn-link" asp-page="/Account/Login/Index" asp-route-returnUrl="@Model.Input.ReturnUrl">Back to sign in</a>
        </div>
    </form>
</div>
