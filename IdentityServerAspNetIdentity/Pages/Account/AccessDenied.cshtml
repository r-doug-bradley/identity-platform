@page
@model IdentityServerAspNetIdentity.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <h1>Access denied</h1>
    <p class="auth-subtitle">You don't have permission to access that resource. If you think this is a mistake, contact your administrator.</p>

    <div class="d-grid">
        <a class="btn btn-primary" asp-page="/Account/Login/Index">Back to sign in</a>
    </div>
</div>
