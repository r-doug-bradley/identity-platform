@page
@model IdentityServerAspNetIdentity.Pages.Login.Index
@{
    ViewData["Title"] = "Sign in";
    Layout = "_AuthLayout";
    var hasLocal = Model.View.EnableLocalLogin;
    var hasExternal = Model.View.VisibleExternalProviders.Any();
}

<div class="auth-card">
    <h1>Sign in</h1>
    <p class="auth-subtitle">Welcome back. Please enter your details.</p>

    <partial name="_ValidationSummary" />

    @if (hasLocal)
    {
        <form asp-page="/Account/Login/Index">
            <input type="hidden" asp-for="Input.ReturnUrl" />

            <div class="mb-3">
                <label class="form-label" asp-for="Input.Username"></label>
                <input class="form-control" placeholder="Username" asp-for="Input.Username" autofocus>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Input.Password"></label>
                <input type="password" class="form-control" placeholder="Password" asp-for="Input.Password" autocomplete="current-password">
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3">
                @if (Model.View.AllowRememberLogin)
                {
                    <div class="form-check">
                        <input class="form-check-input" asp-for="Input.RememberLogin">
                        <label class="form-check-label" asp-for="Input.RememberLogin">Remember me</label>
                    </div>
                }
                else
                {
                    <span></span>
                }
                <a asp-page="/Account/ForgotPassword/Index" asp-route-returnUrl="@Model.Input.ReturnUrl">Forgot password?</a>
            </div>

            <div class="d-grid gap-2">
                <button class="btn btn-primary" name="Input.Button" value="login">Sign in</button>
                <button class="btn btn-link" name="Input.Button" value="cancel">Cancel</button>
            </div>
        </form>
    }

    @if (hasLocal && hasExternal)
    {
        <div class="auth-divider"><span>or</span></div>
    }

    @if (hasExternal)
    {
        <div class="d-grid gap-2">
            @foreach (var provider in Model.View.VisibleExternalProviders)
            {
                <a class="btn btn-outline-secondary"
                   asp-page="/ExternalLogin/Challenge"
                   asp-route-scheme="@provider.AuthenticationScheme"
                   asp-route-returnUrl="@Model.Input.ReturnUrl">
                    Continue with @provider.DisplayName
                </a>
            }
        </div>
    }

    @if (!hasLocal && !hasExternal)
    {
        <div class="alert alert-warning mb-0">
            <strong>Invalid login request.</strong> There are no login schemes configured for this request.
        </div>
    }
</div>
