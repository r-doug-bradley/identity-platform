@page
@model IdentityServerAspNetIdentity.Pages.Login.TwoFactor
@{
    ViewData["Title"] = "Two-factor authentication";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <h1>Two-factor authentication</h1>
    <p class="auth-subtitle">Enter the code from your authenticator app or a recovery code.</p>

    <partial name="_ValidationSummary" />

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-warning">@Model.ErrorMessage</div>
    }

    <form method="post">
        <input type="hidden" asp-for="Input.ReturnUrl" />
        <input type="hidden" asp-for="Input.RememberLogin" />

        <div class="mb-3">
            <label class="form-label" asp-for="Input.Code"></label>
            <input class="form-control" asp-for="Input.Code" autocomplete="one-time-code" autofocus inputmode="numeric" />
            <div class="form-text">Authenticator code (6 digits) or recovery code.</div>
        </div>

        <div class="form-check mb-3">
            <input class="form-check-input" asp-for="Input.RememberMachine" />
            <label class="form-check-label" asp-for="Input.RememberMachine"></label>
        </div>

        <div class="d-grid gap-2">
            <button class="btn btn-primary" type="submit">Verify</button>
            <a class="btn btn-link" asp-page="/Account/Login/Index" asp-route-returnUrl="@Model.Input.ReturnUrl">Cancel</a>
        </div>
    </form>
</div>
